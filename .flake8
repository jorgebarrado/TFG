[flake8]
max-line-length = 88
extend-ignore =
    E203,
    W503,
    E501
exclude =
    .git,
    .venv,
    .venv311,
    venv,
    __pycache__,
    migrations,
    tmp,
    node_modules,
    static/vendor,
    tfg_project/citations/static/vendor,
    tfg_project/citations/static/reader/reader.js,
    tfg_project/citations/static/reader/reader.js.map

# ── Configuración principal de Django ────────────────────────────────────────
DJANGO_SECRET_KEY=cambia-esto-por-una-clave-secreta-larga-y-aleatoria
DJANGO_DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# ── Login social (opcional; alternativa a crear los SocialApp en el admin) ────
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
ORCID_CLIENT_ID=
ORCID_CLIENT_SECRET=

# ── Orígenes CSRF extra en producción, separados por coma ────────────────────
CSRF_TRUSTED_ORIGINS=

# ── APIs externas ─────────────────────────────────────────────────────────────
SEMANTIC_SCHOLAR_API_KEY=

# ── Motores de extracción IA (services/ai_extractor.py) ──────────────────────
# Activa solo los motores cuya key configures. Cada motor aparece en el
# dropdown del modal de extracción únicamente si su key está presente.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=

# ── Experimental: GROBID (citations/experimental/grobid/) ────────────────────
GROBID_BASE_URL=http://localhost:8070
GROBID_TIMEOUT=120

# ── Logging y trazas (opcionales) ────────────────────────────────────────────
LOG_CITATIONS=0
LOG_CITATIONS_LEVEL=INFO
TRACE_CITATIONS=0
TRACE_REFERENCES=0
INCLUDE_TRACE_IN_RESPONSE=0

# ── Frontend (solo en desarrollo con Vite) ────────────────────────────────────
READER_VITE_DEV_SERVER=http://localhost:5173

# ── Configuración principal de Django ────────────────────────────────────────
DJANGO_SECRET_KEY=cambia-esto-por-una-clave-secreta-larga-y-aleatoria
DJANGO_DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# ── APIs externas ─────────────────────────────────────────────────────────────
SEMANTIC_SCHOLAR_API_KEY=

# ── Experimental: IA (citations/experimental/ai/) ────────────────────────────
# Detección automática de citas con Gemini (ai_citation_detector.py)
GOOGLE_API_KEY=
# Evaluación de reportes con OpenAI (ai_report_evaluator.py)
OPENAI_API_KEY=

# ── Experimental: GROBID (citations/experimental/grobid/) ────────────────────
GROBID_BASE_URL=http://localhost:8070
GROBID_TIMEOUT=120

# ── Logging y trazas (opcionales) ────────────────────────────────────────────
LOG_CITATIONS=0
LOG_CITATIONS_LEVEL=INFO
TRACE_CITATIONS=0
TRACE_REFERENCES=0
INCLUDE_TRACE_IN_RESPONSE=0

# ── Frontend (solo en desarrollo con Vite) ────────────────────────────────────
READER_VITE_DEV_SERVER=http://localhost:5173
